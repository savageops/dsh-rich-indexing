{
  "name": "dsh-rich-indexing",
  "version": "0.1.0",
  "description": "Tiered compaction hub for DeepSeek Harness: progressive thresholds (default 30/50/70/90) with escalating consolidation laws, a deterministic keyword index folded into every checkpoint, and a summarization model chain (primary + up to 3 fallbacks, each with its own reasoning effort).",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "dsh",
    "compaction",
    "context-management",
    "keyword-index",
    "model-fallback"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savageops/dsh-rich-indexing.git"
  },
  "homepage": "https://github.com/savageops/dsh-rich-indexing#readme",
  "bugs": {
    "url": "https://github.com/savageops/dsh-rich-indexing/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "src/host.js",
  "files": [
    "src",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/"
  }
}
